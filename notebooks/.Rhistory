# Instale uma única vez, se necessário:
# install.packages(c("fixest", "readr", "car", "sf", "spdep", "lmtest",
#                    "sandwich", "spatialreg", "sphet", "knitr", "rmarkdown"))
pacotes = c("fixest", "readr", "car", "sf", "spdep", "lmtest", "sandwich",
"spatialreg", "sphet", "knitr", "rmarkdown")
faltantes = pacotes[!vapply(pacotes, requireNamespace, logical(1), quietly = TRUE)]
if (length(faltantes) > 0) {
stop("Instale antes os pacotes: ", paste(faltantes, collapse = ", "))
}
# Chamadas pacote::funcao evitam conflitos entre bibliotecas.
options(scipen = 999, width = 180)
knitr::opts_chunk$set(echo = TRUE, warning = TRUE, message = FALSE)
caminho_csv = path.expand("~/violência/data/crime_violento_2022_2025.csv")
# Cache persistente da malha, ao lado do CSV.
pasta_malha = file.path(dirname(caminho_csv), "malha_ce_2022")
df = as.data.frame(readr::read_csv(caminho_csv, show_col_types = FALSE))
names(df) = trimws(sub("^\ufeff", "", names(df)))
if (!"code_muni" %in% names(df)) stop("A base precisa da coluna code_muni.")
df$code_muni = as.character(df$code_muni)
stopifnot(!anyNA(df$code_muni), !anyDuplicated(df$code_muni))
# Impede produzir log1p de contagens negativas.
stopifnot(all(df$cvli_2022 >= 0, na.rm = TRUE),
all(df$cvli_2025 >= 0, na.rm = TRUE))
df$crescimento_cvli_log_2022_2025 =
log1p(df$cvli_2025) - log1p(df$cvli_2022)
# M1: controles iniciais e crescimento populacional, sem setores/crime inicial.
formula1 = crescimento_cvli_log_2022_2025 ~
log(urbanizacao_2022) +
log(taxa_desocupacao_2022_pct) +
log(rendimento_medio_mensal_2022_brl) +
log(populacao_2022) +
crescimento_populacional_2022_2025_pct +
log(densidade_2022_hab_km2) +
log(taxa_sem_instrucao_ou_fundamental_incompleto_2022_pct)
# M2: seis participações e condição inicial.
formula2 = update(
formula1,
. ~ . + log1p(cvli_2022) + tx_adm_pub + tx_agro + tx_comercio +
tx_construcao_civil + tx_industria_transformacao + tx_servicos
)
# M3: mesma especificação que você vinha usando, sem administração pública.
formula3 = update(formula2, . ~ . - tx_adm_pub)
vars_log = c(
"urbanizacao_2022", "taxa_desocupacao_2022_pct",
"rendimento_medio_mensal_2022_brl", "populacao_2022",
"densidade_2022_hab_km2",
"taxa_sem_instrucao_ou_fundamental_incompleto_2022_pct"
)
nao_positivos = vapply(df[vars_log], function(x) sum(x <= 0, na.rm = TRUE), numeric(1))
if (any(nao_positivos > 0)) {
print(nao_positivos[nao_positivos > 0])
stop("Há zeros ou negativos em variáveis com log. Reveja a transformação.")
}
quadro_completo = model.frame(formula2, data = df, na.action = na.pass)
valida = Reduce(`&`, lapply(quadro_completo, is.finite))
if (any(!valida)) {
print(df[!valida, intersect(c("code_muni", "municipio"), names(df)), drop = FALSE])
}
base_modelo = df[valida, , drop = FALSE]
base_modelo = base_modelo[order(base_modelo$code_muni), , drop = FALSE]
rownames(base_modelo) = base_modelo$code_muni
stopifnot(nrow(base_modelo) > ncol(quadro_completo))
print(data.frame(
Total = nrow(df), Incluidos = nrow(base_modelo), Excluidos = sum(!valida)
))
modelo1 = fixest::feols(formula1, data = base_modelo, vcov = "iid")
modelo2 = fixest::feols(formula2, data = base_modelo, vcov = "iid")
modelo3 = fixest::feols(formula3, data = base_modelo, vcov = "iid")
summary(modelo1)
summary(modelo2)
summary(modelo3)
modelo2_lm = lm(formula2, data = base_modelo, na.action = na.fail)
modelo3_lm = lm(formula3, data = base_modelo, na.action = na.fail)
# Conferir equivalência dos coeficientes e tamanho da amostra.
b_fixest = coef(modelo3)
b_lm = coef(modelo3_lm)[names(b_fixest)]
stopifnot(
nobs(modelo3) == nobs(modelo3_lm),
length(b_fixest) == length(coef(modelo3_lm)),
!anyNA(b_lm),
isTRUE(all.equal(unname(b_fixest), unname(b_lm), tolerance = 1e-6))
)
car::vif(modelo2_lm)
car::vif(modelo3_lm)
bp = lmtest::bptest(modelo3_lm, studentize = TRUE)
bp
# Sensibilidade da inferência do MQO à heterocedasticidade.
# HC3 NÃO corrige dependência espacial e não é a covariância do SEM.
# Fornecer ao summary do fixest a covariância HC3 calculada no lm equivalente.
vcov_hc3 = sandwich::vcovHC(modelo3_lm, type = "HC3")
vcov_hc3 = vcov_hc3[names(coef(modelo3)), names(coef(modelo3)), drop = FALSE]
summary(modelo3, vcov = vcov_hc3)
op = par(mfrow = c(2, 2))
plot(modelo3_lm, which = c(1, 2, 4, 5))
par(op)
dir.create(pasta_malha, recursive = TRUE, showWarnings = FALSE)
arquivo_zip = file.path(pasta_malha, "CE_Municipios_2022.zip")
url_malha = paste0(
"https://geoftp.ibge.gov.br/organizacao_do_territorio/",
"malhas_territoriais/malhas_municipais/",
"municipio_2022/UFs/CE/CE_Municipios_2022.zip"
)
arquivo_shp = list.files(pasta_malha, pattern = "\\.shp$",
full.names = TRUE, recursive = TRUE)
if (length(arquivo_shp) == 0) {
download.file(url_malha, destfile = arquivo_zip, mode = "wb")
unzip(arquivo_zip, exdir = pasta_malha)
arquivo_shp = list.files(pasta_malha, pattern = "\\.shp$",
full.names = TRUE, recursive = TRUE)
}
stopifnot(length(arquivo_shp) == 1)
malha_ce = sf::st_read(arquivo_shp, quiet = TRUE)
malha_ce = sf::st_transform(malha_ce, 31984)
malha_ce = sf::st_make_valid(malha_ce)
stopifnot(!anyDuplicated(as.character(malha_ce$CD_MUN)))
posicoes = match(base_modelo$code_muni, as.character(malha_ce$CD_MUN))
if (anyNA(posicoes)) stop("Há municípios da base sem correspondência na malha.")
malha_modelo = malha_ce[posicoes, ]
stopifnot(
identical(as.character(malha_modelo$CD_MUN), base_modelo$code_muni),
!any(sf::st_is_empty(malha_modelo))
)
vizinhos = spdep::poly2nb(
malha_modelo, queen = TRUE, row.names = base_modelo$code_muni
)
summary(spdep::card(vizinhos))
sem_vizinhos = which(spdep::card(vizinhos) == 0)
if (length(sem_vizinhos) > 0) {
print(sf::st_drop_geometry(malha_modelo[sem_vizinhos, c("CD_MUN", "NM_MUN")]))
stop("Existem municípios sem vizinhos. Reveja a geometria/amostra antes de continuar.")
}
spdep::n.comp.nb(vizinhos)$nc
pesos_w = spdep::nb2listw(vizinhos, style = "W", zero.policy = FALSE)
stopifnot(
identical(rownames(model.frame(modelo3_lm)), attr(vizinhos, "region.id")),
nobs(modelo3) == length(vizinhos)
)
y_modelo = model.response(model.frame(modelo3_lm))
names(y_modelo) = rownames(base_modelo)
moran_resposta = spdep::moran.test(
y_modelo, listw = pesos_w, alternative = "two.sided",
zero.policy = FALSE, spChk = TRUE
)
moran_resposta
moran_residuos = spdep::lm.morantest(
modelo3_lm, listw = pesos_w, alternative = "two.sided",
zero.policy = FALSE, spChk = TRUE, naSubset = FALSE
)
moran_residuos
testes_rs = spdep::lm.RStests(
modelo3_lm, listw = pesos_w,
test = c("RSerr", "RSlag", "adjRSerr", "adjRSlag"),
zero.policy = FALSE, spChk = TRUE, naSubset = FALSE
)
testes_rs
formula_base = formula3
base_sem = base_modelo
mod_sem = spatialreg::errorsarlm(
formula_base, data = base_sem, listw = pesos_w,
Durbin = FALSE, method = "eigen", na.action = na.fail, zero.policy = FALSE
)
mod_sar = spatialreg::lagsarlm(
formula_base, data = base_sem, listw = pesos_w,
Durbin = FALSE, method = "eigen", na.action = na.fail, zero.policy = FALSE
)
mod_sarar = spatialreg::sacsarlm(
formula_base, data = base_sem, listw = pesos_w, listw2 = pesos_w,
Durbin = FALSE, method = "eigen", na.action = na.fail, zero.policy = FALSE
)
mod_sdm = spatialreg::lagsarlm(
formula_base, data = base_sem, listw = pesos_w,
Durbin = TRUE, method = "eigen", na.action = na.fail, zero.policy = FALSE
)
modelos_mv = list(SEM = mod_sem, SAR = mod_sar, SARAR = mod_sarar, SDM = mod_sdm)
summary(mod_sem)
summary(mod_sar)
summary(mod_sarar)
summary(mod_sdm)
summary(mod_sem)
summary(mod_sar)
summary(mod_sarar)
summary(mod_sdm)
# MQO_lm é equivalente ao modelo3 do fixest. Usá-lo aqui mantém a convenção
# de log-verossimilhança/contagem de parâmetros na comparação com spatialreg.
modelos = c(list(MQO = modelo3_lm), modelos_mv)
n_modelos = vapply(modelos, nobs, numeric(1))
stopifnot(length(unique(n_modelos)) == 1)
comparacao = data.frame(
Modelo = names(modelos), N = as.integer(n_modelos),
Parametros = vapply(modelos, function(m) as.numeric(attr(logLik(m), "df")), numeric(1)),
LogLik = vapply(modelos, function(m) as.numeric(logLik(m)), numeric(1)),
AIC = vapply(modelos, AIC, numeric(1)),
BIC = vapply(modelos, BIC, numeric(1)), row.names = NULL
)
comparacao$Delta_AIC = comparacao$AIC - min(comparacao$AIC)
comparacao = comparacao[order(comparacao$AIC), ]
print(comparacao, digits = 5, row.names = FALSE)
quadro_sem = model.frame(formula_base, data = base_sem, na.action = na.fail)
y_sem = model.response(quadro_sem)
X_sem = model.matrix(formula_base, data = quadro_sem)
beta_sem = mod_sem$coefficients[colnames(X_sem)]
stopifnot(!anyNA(beta_sem))
u_sem = as.numeric(y_sem - X_sem %*% beta_sem)
inovacoes_sem = u_sem - mod_sem$lambda * spdep::lag.listw(
pesos_w, u_sem, zero.policy = FALSE
)
names(inovacoes_sem) = rownames(base_sem)
moran_inovacoes_sem = spdep::moran.test(
inovacoes_sem, listw = pesos_w, alternative = "two.sided",
zero.policy = FALSE, spChk = TRUE
)
moran_inovacoes_sem
mod_sem_gmm = sphet::spreg(
formula = formula_base, data = base_sem, listw = pesos_w,
model = "error", het = TRUE, Durbin = FALSE, na.action = na.fail
)
summary(mod_sem_gmm)
